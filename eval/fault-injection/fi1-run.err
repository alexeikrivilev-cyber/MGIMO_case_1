[0m$ [0mpython3 - <<'EOF'
import csv
from collections import Counter

path = "project/materials/telco-customer-churn.csv"
with open(path, newline="", encoding="utf-8") as f:
    reader = csv.DictReader(f)
    rows = list(reader)
    cols = reader.fieldnames

print("columns:", cols)
print("records:", len(rows))

churn_col = next((c for c in cols if c and c.strip().lower() == "churn"), None)
print("churn_col:", churn_col)
if churn_col:
    counts = Counter(r[churn_col] for r in rows)
    total = sum(counts.values())
    print("churn counts:", dict(counts))
    for k, v in counts.items():
        print(f"share[{k}]: {v}/{total} = {v/total:.4f} ({v/total*100:.2f}%)")
EOF
