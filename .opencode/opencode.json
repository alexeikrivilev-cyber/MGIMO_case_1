{
  "$schema": "https://opencode.ai/config.json",
  "model": "stepfun/step-5-preview",
  "instructions": ["docs/agents-md-staged.md"],
  "provider": {
    "stepfun": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "StepFun",
      "options": {
        "baseURL": "https://api.stepfun.ai/step_plan/v1",
        "apiKey": "{env:STEPFUN_API_KEY}"
      },
      "models": {
        "step-5-preview": {
          "name": "Step 5 Preview"
        },
        "step-3.7-flash": {
          "name": "Step 3.7 Flash"
        }
      }
    }
  },
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow"
  }
}
