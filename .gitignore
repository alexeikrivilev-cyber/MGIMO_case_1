# --- Окружение и секреты ---
.env
*.env
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# --- Node (если появятся локальные зависимости плагинов) ---
node_modules/

# --- ОС и редакторы ---
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# --- Кэш проверок и прогонов ---
.pytest_cache/
.cache/
__pycache__/
*.pyc

# --- OpenCode: окружение/зависимости/логи — вне git; конфиг и плагины — в git ---
.opencode/node_modules/
.opencode/hooks.log
.hermes-run.log

# --- Бенчмарк-стенд: сырьё перекачиваемо (URL — в fetch_data.sh), в git не идёт ---
eval/benchmarks/dabstep/data/

# --- Метка прогона для хука cost-append (TASK-hermes-6 п.4: STATE.md раннеры не трогают) ---
eval/.cost-label

# --- Lock журнала мутаций навыков (runtime, не содержимое) ---
knowledge/skills/.evolution/.locks/

# =====================================================================
# --- Лаборатория разработки: артефакты работы организаторам не нужны ---
# В git остаётся только курируемый набор доказательств (negation-список
# ниже). Полный набор артефактов хранится локально и пересоздаётся
# прогонами стенда (см. README §9 «Что в репозитории, а что — нет»).
#
# Правило: всё под eval/runs/ вне git, КРОМЕ перечисленных доказательств.
eval/runs/*
!eval/runs/t18-case/
!eval/runs/t18-case-heldout/
!eval/runs/t20-gate-revision/
!eval/runs/t16-addendum/
!eval/runs/t17-axis/
!eval/runs/ab-options-demo-retention/
!eval/runs/critic-matrix/
!eval/runs/t13-blindpairs/
!eval/runs/t7-rescore/
!eval/runs/t17-actionability/
!eval/runs/t18-case-launch.log

# --- точечные курируемые доказательства, читаемые тестами и цитируемые в измерениях ---
eval/runs/t7-rescore/*
!eval/runs/t7-rescore/summary.json
eval/runs/t17-actionability/*
!eval/runs/t17-actionability/gates-vs-human-v2.md

# --- демо-прогон кейса: журнал, решение, артефакты, финальные гейты ---
eval/runs/t18-case/*
!eval/runs/t18-case/manifest.md
!eval/runs/t18-case/case-solution.md
!eval/runs/t18-case/self-check-6q.md
!eval/runs/t18-case/step1-verification.md
!eval/runs/t18-case/artifacts/
!eval/runs/t18-case/gates/
!eval/runs/t18-case/critic4/
!eval/runs/t18-case/critic5/
eval/runs/t18-case/gates/*
!eval/runs/t18-case/gates/final-*.gate.txt
eval/runs/t18-case/critic4/*
!eval/runs/t18-case/critic4/findings.md
eval/runs/t18-case/critic5/*
!eval/runs/t18-case/critic5/findings.md
eval/runs/t18-case/artifacts/*
!eval/runs/t18-case/artifacts/*.md

# --- held-out прогон (переносимость): журнал и проверка шага 1 ---
eval/runs/t18-case-heldout/*
!eval/runs/t18-case-heldout/manifest.md
!eval/runs/t18-case-heldout/step1-verification.md

# --- раунд доводки артефактов шагов 4–5 до гейтов (task 20): журнал ---
eval/runs/t20-gate-revision/*
!eval/runs/t20-gate-revision/manifest.md

# --- регрессионные фикстуры и курируемые доказательства исследований ---
# (t16-addendum, t17-axis, ab-options-demo-retention, critic-matrix,
#  t13-blindpairs — читаются тестами и цитируются в measurements.md)

# --- сырые выводы моделей и лог-хвосты anywhere ---
**/*.out
**/*.err
**/*.start
**/*.end
**/*.jsonl
# кроме закоммиченных фикстур/доказательств:
!tests/fixtures/**/*.out
!eval/runs/t16-addendum/**/*.out
!eval/runs/t16-addendum/**/*.err
!eval/fault-injection/*
!eval/runs/t18-case/critic4/critic.out
!eval/runs/t18-case/critic5/critic.out

# --- сырьё задач и бенчмарков перекачиваемо (URL — в скриптах) ---
# Исключение — анализируемый CSV held-out (ev-001…ev-007 считаются из
# него; скрипт-арбитр eval/recompute_heldout_slices.py и его тест
# читают именно его). Политика О3: «анализируемые CSV — идут» (как
# telco-CSV демо в project/materials/).
eval/tasks/*/artifacts/materials/*
!eval/tasks/heldout-growth-segment/artifacts/materials/bank-additional/
!eval/tasks/heldout-growth-segment/artifacts/materials/bank-additional/bank-additional-full.csv
eval/tasks/heldout-growth-segment/artifacts/materials/bank-additional/*
!eval/tasks/heldout-growth-segment/artifacts/materials/bank-additional/bank-additional-full.csv
eval/benchmarks/dabstep/data/

# --- резервные копии артефактов до ревизии ---
**/*.critic-backup

# --- сырые выводы советов (council) внутри демо-проекта ---
# Исключение — выходы Phase 2 пяти ролей единственного прогона
# Консилиума: это доказательство квот протокола (R1–R3), которое
# проверяет scripts/council_quota.py (тест test_real_council_run_passes);
# агрегированные фазы и синтез уже курированы в git.
project/council/run-*/*.out
!project/council/run-2026-11-16-01/phase2-product.out
!project/council/run-2026-11-16-01/phase2-comms.out
!project/council/run-2026-11-16-01/phase2-data.out
!project/council/run-2026-11-16-01/phase2-devil.out
!project/council/run-2026-11-16-01/phase2-user.out
project/council/run-*/*.err
project/council/run-*/*.start
project/council/run-*/*.end

