# --- ОС и редакторы ---
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# --- Кэш проверок и прогонов ---
.pytest_cache/
.cache/
__pycache__/
*.pyc

# --- OpenCode: окружение/зависимости/логи — вне git; конфиг и плагины — в git ---
.opencode/node_modules/
.opencode/hooks.log
.hermes-run.log

# --- Бенчмарк-стенд: сырьё перекачиваемо (URL — в fetch_data.sh), в git не идёт ---
eval/benchmarks/dabstep/data/

# --- Метка прогона для хука cost-append (TASK-hermes-6 п.4: STATE.md раннеры не трогают) ---
eval/.cost-label

# --- Lock журнала мутаций навыков (runtime, не содержимое) ---
knowledge/skills/.evolution/.locks/

# =====================================================================
# --- Лаборатория разработки: артефакты работы организаторам не нужны ---
# В git остаётся только курируемый набор доказательств (negation-список
# ниже). Полный набор артефактов хранится локально и пересоздаётся
# прогонами стенда (см. README §9 «Что в репозитории, а что — нет»).
#
# Правило: всё под eval/runs/ вне git, КРОМЕ перечисленных доказательств.
eval/runs/*
!eval/runs/t18-case/
!eval/runs/t18-case-heldout/
!eval/runs/t20-gate-revision/
!eval/runs/t16-addendum/
!eval/runs/t17-axis/
!eval/runs/ab-options-demo-retention/
!eval/runs/critic-matrix/
!eval/runs/t13-blindpairs/
!eval/runs/t7-rescore/
!eval/runs/t17-actionability/
!eval/runs/t18-case-launch.log

# --- точечные курируемые доказательства, читаемые тестами и цитируемые в измерениях ---
eval/runs/t7-rescore/*
!eval/runs/t7-rescore/summary.json
eval/runs/t17-actionability/*
!eval/runs/t17-actionability/gates-vs-human-v2.md

# --- демо-прогон кейса: журнал, решение, артефакты, финальные гейты ---
eval/runs/t18-case/*
!eval/runs/t18-case/manifest.md
!eval/runs/t18-case/case-solution.md
!eval/runs/t18-case/self-check-6q.md
!eval/runs/t18-case/step1-verification.md
!eval/runs/t18-case/artifacts/
!eval/runs/t18-case/gates/
!eval/runs/t18-case/critic4/
!eval/runs/t18-case/critic5/
eval/runs/t18-case/gates/*
!eval/runs/t18-case/gates/final-*.gate.txt
eval/runs/t18-case/critic4/*
!eval/runs/t18-case/critic4/findings.md
eval/runs/t18-case/critic5/*
!eval/runs/t18-case/critic5/findings.md
eval/runs/t18-case/artifacts/*
!eval/runs/t18-case/artifacts/*.md

# --- held-out прогон (переносимость): журнал и проверка шага 1 ---
eval/runs/t18-case-heldout/*
!eval/runs/t18-case-heldout/manifest.md
!eval/runs/t18-case-heldout/step1-verification.md

# --- раунд доводки артефактов шагов 4–5 до гейтов (task 20): журнал ---
eval/runs/t20-gate-revision/*
!eval/runs/t20-gate-revision/manifest.md

# --- эксперимент «длинный диалог» (TASK-hermes-23): журнал и данные ---
# В git — предрегистрация (заморожена ДО прогонов), шаблон промпта,
# вердикт (summary.md), метрики (metrics.json), сид руки B (копия
# STATE.md — файл вне git, без копии сид невоспроизводим), манифест сида
# руки A (сид = проектные файлы + sha256, seed.md на диске) и ДОСЛОВНЫЕ
# ответы всех 12 поворотов трёх рук — это первичные данные эксперимента,
# без которых M1–M3 не пересчитать. Поворотовые .json, gates/ и логи —
# вне git, воспроизводятся драйверами eval/run_long_dialogue.py и
# eval/score_long_dialogue.py.
!eval/runs/t23-longdialogue/
eval/runs/t23-longdialogue/*
!eval/runs/t23-longdialogue/PREREGISTRATION.md
!eval/runs/t23-longdialogue/prompt-template.md
!eval/runs/t23-longdialogue/M1-adjudication.md
!eval/runs/t23-longdialogue/summary.md
!eval/runs/t23-longdialogue/metrics.json
!eval/runs/t23-longdialogue/A/
!eval/runs/t23-longdialogue/B/
!eval/runs/t23-longdialogue/C/
!eval/runs/t23-longdialogue/A-defective-contract/
eval/runs/t23-longdialogue/A/*
!eval/runs/t23-longdialogue/A/seed-manifest.json
!eval/runs/t23-longdialogue/A/turn-*.answer.md
eval/runs/t23-longdialogue/B/*
!eval/runs/t23-longdialogue/B/state-as-used.md
!eval/runs/t23-longdialogue/B/turn-*.answer.md
eval/runs/t23-longdialogue/C/*
!eval/runs/t23-longdialogue/C/turn-*.answer.md
# дефектный первый прогон руки A: в git только описание дефекта — на него
# ссылаются summary.md, examples/proof.md §11 и LOG.md; ответы того прогона
# не в git (тот же класс данных, что и у исправленной руки, но не она).
eval/runs/t23-longdialogue/A-defective-contract/*
!eval/runs/t23-longdialogue/A-defective-contract/DEFECT.md

# --- эксперимент «предел длины диалога» (TASK-hermes-26, §34) ---
# Тот же контракт, что у t23: предрегистрация (копия §34, зафиксирована
# коммитом 8df913a ДО прогонов), вердикт, метрики, ПОЛНАЯ адъюдикация M1
# (md для человека + json для скорера — правило §34.3(а) требует решения
# по каждой сырой находке), сырые находки (m1-raw.json) и дословные ответы
# 36 поворотов рук A2 и C2. Поворотовые .json, gates/, seed.md и логи —
# вне git, воспроизводятся драйверами. Руки B в этом эксперименте нет
# (решение §34.1).
!eval/runs/t26-longdialogue36/
eval/runs/t26-longdialogue36/*
!eval/runs/t26-longdialogue36/PREREGISTRATION.md
!eval/runs/t26-longdialogue36/M1-adjudication.md
!eval/runs/t26-longdialogue36/M1-adjudication.json
!eval/runs/t26-longdialogue36/summary.md
!eval/runs/t26-longdialogue36/metrics.json
!eval/runs/t26-longdialogue36/m1-raw.json
!eval/runs/t26-longdialogue36/A/
!eval/runs/t26-longdialogue36/C/
eval/runs/t26-longdialogue36/A/*
!eval/runs/t26-longdialogue36/A/seed-manifest.json
!eval/runs/t26-longdialogue36/A/turn-*.answer.md
eval/runs/t26-longdialogue36/C/*
!eval/runs/t26-longdialogue36/C/turn-*.answer.md
# останов по лимиту контекста (§34.2) — если случится: это результат,
# он обязан быть в git рядом с вердиктом.
!eval/runs/t26-longdialogue36/CONTEXT-LIMIT.md
!eval/runs/t26-longdialogue36/A/CONTEXT-LIMIT.md

